{
  "name": "@neurealistic/backlog-mcp",
  "version": "0.1.0",
  "description": "MCP server for a markdown task backlog (Backlog.md-compatible) with atomic, collision-safe id assignment.",
  "type": "module",
  "bin": {
    "backlog-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "backlog",
    "tasks",
    "markdown"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neurealistic/backlog-mcp.git"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
